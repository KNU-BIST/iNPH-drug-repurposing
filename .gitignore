# History and session files
.Rhistory
.Rapp.history
.RData
.RDataTmp
.Ruserdata

# RStudio files
.Rproj.user/

# Renv library (kept in lockfile, not in tree)
renv/library/
renv/local/
renv/cellar/
renv/lock/
renv/python/
renv/staging/

# Targets pipeline cache
_targets/

# OS junk
.DS_Store
Thumbs.db
*~
.idea/
.vscode/

# Knitr/Quarto build artefacts
*.html
*_files/
*_cache/
/.quarto/

# Data — never commit raw or processed data
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/external/*
!data/external/.gitkeep

# Figures and results — kept locally, regenerated by pipeline
figures/*
!figures/.gitkeep
results/*
!results/.gitkeep
reports/*.html
reports/*.pdf
!reports/.gitkeep

# Sensitive
.env
.Renviron.local
*.key
secrets/

# R package build artefacts
*.tar.gz
*.Rcheck/
.Renviron
# Internal archive - superseded scripts/data, kept locally only
Archived/
.positai
